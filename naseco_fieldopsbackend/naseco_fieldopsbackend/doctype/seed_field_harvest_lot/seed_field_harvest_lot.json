{
 "doctype": "DocType",
 "name": "Seed Field Harvest Lot",
 "module": "Naseco FieldOpsBackend",
 "engine": "InnoDB",
 "autoname": "format:SFHL-{YYYY}-{#####}",
 "track_changes": 1,
 "field_order": ["source_section", "production_lot", "crop_cycle", "season", "crop", "variety", "production_category", "harvest_section", "harvest_date", "harvested_qty_kg", "accepted_qty_kg", "harvest_reference", "notes"],
 "fields": [
  {"fieldname": "source_section", "fieldtype": "Section Break", "label": "Field Source"},
  {"fieldname": "production_lot", "fieldtype": "Link", "label": "Crop Production Lot", "options": "Crop Production Lot", "reqd": 1, "in_list_view": 1},
  {"fieldname": "crop_cycle", "fieldtype": "Link", "label": "Crop Cycle", "options": "Crop Cycle", "read_only": 1},
  {"fieldname": "season", "fieldtype": "Link", "label": "Season", "options": "Season", "read_only": 1, "in_list_view": 1},
  {"fieldname": "crop", "fieldtype": "Link", "label": "Crop", "options": "Crop", "read_only": 1},
  {"fieldname": "variety", "fieldtype": "Link", "label": "Variety", "options": "Crop Variety", "read_only": 1},
  {"fieldname": "production_category", "fieldtype": "Link", "label": "Production Category", "options": "Seed Category", "read_only": 1},
  {"fieldname": "harvest_section", "fieldtype": "Section Break", "label": "Physical Harvest"},
  {"fieldname": "harvest_date", "fieldtype": "Date", "label": "Harvest Date", "reqd": 1, "in_list_view": 1},
  {"fieldname": "harvested_qty_kg", "fieldtype": "Float", "label": "Harvested Quantity (kg)", "reqd": 1, "precision": "1"},
  {"fieldname": "accepted_qty_kg", "fieldtype": "Float", "label": "Accepted Quantity (kg)", "precision": "1"},
  {"fieldname": "harvest_reference", "fieldtype": "Data", "label": "External Harvest Reference"},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1},
  {"role": "Parent Seed Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1},
  {"role": "Outgrower Manager", "read": 1, "report": 1}
 ]
}
