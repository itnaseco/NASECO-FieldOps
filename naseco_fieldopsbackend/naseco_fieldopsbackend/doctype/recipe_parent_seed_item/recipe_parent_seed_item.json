{
 "actions": [],
 "doctype": "DocType",
 "editable_grid": 1,
 "engine": "InnoDB",
 "istable": 1,
 "field_order": [
  "ux_details_section",
  "variety",
  "parentage",
  "parent_variety",
  "ux_additional_details_section",
  "parent_role",
  "ratio_group",
  "required_seed_category",
  "required_seed_class",
  "ux_additional_details_column_2_column",
  "item_code",
  "ux_quantities_and_values_section",
  "ratio_value",
  "population_percent",
  "expected_plants_per_hectare",
  "calculation_basis",
  "lot_analysis",
  "germination_percent",
  "thousand_kernel_weight_g",
  "batch_no",
  "analysis_test_date",
  "analysis_valid_until",
  "quantity_per_hectare",
  "uom",
  "stock_uom",
  "ux_quantities_and_values_column_2_column",
  "recovery_policy",
  "recoverable_percent",
  "source_warehouse"
 ],
 "fields": [
  {
   "fieldname": "ux_details_section",
   "fieldtype": "Section Break",
   "label": "Details"
  },
  {
   "description": "Leave blank for a generic component. Variety-specific rows replace generic rows for that target variety.",
   "fieldname": "variety",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Applicable Production Variety",
   "options": "Crop Variety"
  },
  {
   "fieldname": "parentage",
   "fieldtype": "Link",
   "label": "Seed Variety Parentage",
   "options": "Seed Variety Parentage"
  },
  {
   "description": "Genetic parent variety. This is separate from the applicable production variety above.",
   "fieldname": "parent_variety",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Parent Variety",
   "options": "Crop Variety"
  },
  {
   "fieldname": "ux_additional_details_section",
   "fieldtype": "Section Break",
   "label": "Additional Details"
  },
  {
   "fieldname": "parent_role",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Parent Role",
   "options": "Female\nMale\nBasic Seed",
   "reqd": 1
  },
  {
   "default": "Primary",
   "fieldname": "ratio_group",
   "fieldtype": "Data",
   "label": "Ratio Group",
   "reqd": 1
  },
  {
   "fieldname": "required_seed_category",
   "fieldtype": "Link",
   "label": "Required Seed Category",
   "options": "Seed Category"
  },
  {
   "fieldname": "required_seed_class",
   "fieldtype": "Link",
   "label": "Required Seed Class",
   "options": "Seed Class"
  },
  {
   "fieldname": "ux_additional_details_column_2_column",
   "fieldtype": "Column Break",
   "label": "Additional Details Column 2"
  },
  {
   "fieldname": "item_code",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Seed Item",
   "options": "Item"
  },
  {
   "fieldname": "ux_quantities_and_values_section",
   "fieldtype": "Section Break",
   "label": "Quantities and Values"
  },
  {
   "fieldname": "ratio_value",
   "fieldtype": "Float",
   "in_list_view": 1,
   "label": "Ratio Value",
   "non_negative": 1
  },
  {
   "fieldname": "population_percent",
   "fieldtype": "Percent",
   "label": "Population %",
   "precision": 6,
   "read_only": 1
  },
  {
   "fieldname": "expected_plants_per_hectare",
   "fieldtype": "Float",
   "label": "Expected Plants per Hectare",
   "precision": 6,
   "read_only": 1
  },
  {
   "default": "Recipe Planning Assumption",
   "fieldname": "calculation_basis",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Calculation Basis",
   "options": "Recipe Planning Assumption\nApproved Lot Analysis"
  },
  {
   "depends_on": "eval:doc.calculation_basis==\"Approved Lot Analysis\"",
   "fieldname": "lot_analysis",
   "fieldtype": "Link",
   "label": "Parent Seed Lot Analysis",
   "options": "Parent Seed Lot Analysis"
  },
  {
   "fieldname": "germination_percent",
   "fieldtype": "Percent",
   "in_list_view": 1,
   "label": "Germination %",
   "precision": 4,
   "read_only_depends_on": "eval:doc.calculation_basis==\"Approved Lot Analysis\""
  },
  {
   "fieldname": "thousand_kernel_weight_g",
   "fieldtype": "Float",
   "label": "Thousand-Kernel Weight (g)",
   "precision": 6,
   "read_only_depends_on": "eval:doc.calculation_basis==\"Approved Lot Analysis\""
  },
  {
   "fieldname": "batch_no",
   "fieldtype": "Link",
   "label": "Analysis Batch",
   "options": "Batch",
   "read_only": 1
  },
  {
   "fieldname": "analysis_test_date",
   "fieldtype": "Date",
   "label": "Analysis Test Date",
   "read_only": 1
  },
  {
   "fieldname": "analysis_valid_until",
   "fieldtype": "Date",
   "label": "Analysis Valid Until",
   "read_only": 1
  },
  {
   "fieldname": "quantity_per_hectare",
   "fieldtype": "Float",
   "in_list_view": 1,
   "label": "Quantity per Hectare",
   "non_negative": 1,
   "read_only_depends_on": "eval:parent.parent_seed_calculation_method==\"Ratio and Lot Analysis\""
  },
  {
   "fieldname": "uom",
   "fieldtype": "Link",
   "label": "Recipe UOM",
   "options": "UOM"
  },
  {
   "fieldname": "stock_uom",
   "fieldtype": "Link",
   "label": "Stock UOM",
   "options": "UOM",
   "read_only": 1
  },
  {
   "fieldname": "ux_quantities_and_values_column_2_column",
   "fieldtype": "Column Break",
   "label": "Quantities and Values Column 2"
  },
  {
   "default": "Fully Recoverable",
   "fieldname": "recovery_policy",
   "fieldtype": "Select",
   "label": "Recovery Policy",
   "options": "Fully Recoverable\nPartially Recoverable\nCompany Subsidy\nNon-Recoverable\nReturnable",
   "reqd": 1
  },
  {
   "default": "100",
   "fieldname": "recoverable_percent",
   "fieldtype": "Percent",
   "label": "Recoverable %"
  },
  {
   "fieldname": "source_warehouse",
   "fieldtype": "Link",
   "label": "Source Warehouse",
   "options": "Warehouse"
  }
 ],
 "module": "Naseco FieldOpsBackend",
 "name": "Recipe Parent Seed Item",
 "permissions": []
}
